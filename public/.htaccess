<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Serve existing files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Everything else -> index.html (React Router handles it)
  RewriteRule ^ index.html [L]
</IfModule>
